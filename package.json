{
  "name": "netflix-categories",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter netflix-categories-chrome dev",
    "dev:landing": "bun run --filter @netflix-categories/landing dev",
    "build": "turbo run build",
    "build:extension": "turbo run build --filter=netflix-categories-chrome",
    "build:landing": "turbo run build --filter=@netflix-categories/landing",
    "zip": "bun run --filter netflix-categories-chrome zip",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "validate:data": "bun run --filter @netflix-categories/data validate",
    "validate:release": "bun run --filter netflix-categories-chrome validate:release"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.3"
  },
  "packageManager": "bun@1.4.2"
}
