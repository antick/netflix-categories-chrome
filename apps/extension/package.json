  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "linkedom": "0.18.13",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
