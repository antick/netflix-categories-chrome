---
import { Image } from "astro:assets";
import icon from "../../../extension/public/icons/icon-128.png";
import { navigation, site } from "../lib/site";
import { buttonVariants } from "./ui/button";
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5">
    <a href="/" class="flex items-center gap-2.5 font-extrabold tracking-tight">
      <Image src={icon} alt="" width={28} height={28} class="rounded-md" />
      <span class="whitespace-nowrap text-[15px] sm:text-base">
        Categories for Netflix
      </span>
      <span class="hidden font-medium text-muted-foreground sm:inline">
        · unofficial
      </span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/codes"
        class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:text-foreground md:hidden"
      >
        Codes
      </a>
      <a
        href={site.install}
        class={buttonVariants({
          size: "sm",
          className: "ml-2 hidden sm:inline-flex",
        })}
      >
        Add to Chrome
      </a>
    </nav>
  </div>
</header>
