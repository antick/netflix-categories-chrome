---
import { formatCount, totalCategories } from "../lib/categories";
import { site } from "../lib/site";
import { buttonVariants } from "./ui/button";
---
<section class="border-t border-border/60 glow">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 py-20 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">
        {formatCount(totalCategories)} genres. Zero scrolling past the same ten rows.
      </h2>
      <p class="mt-3 text-muted-foreground">Free on the Chrome Web Store, with nothing to sign up for.</p>
    </div>
    <a href={site.install} class={buttonVariants({ size: "lg", className: "shrink-0" })}>
      Add to Chrome
    </a>
  </div>
</section>
