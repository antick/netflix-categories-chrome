---
import { questions } from "../lib/site";
---
<section id="questions" class="border-t border-border/60">
  <div class="mx-auto max-w-3xl px-5 py-20">
    <p class="font-mono text-xs font-bold tracking-[0.12em] text-primary">QUESTIONS</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Good to know</h2>
    <div class="mt-8 divide-y divide-border rounded-xl border border-border bg-card">
      {
        questions.map((item) => (
          <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {item.question}
              <span
                aria-hidden="true"
                class="font-mono text-primary transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-muted-foreground">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
