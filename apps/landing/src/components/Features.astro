---
import { Image } from "astro:assets";
import browse from "../assets/popup-browse.png";
import { features, steps } from "../lib/site";
---
<section id="how-it-works" class="border-t border-border/60">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-[1fr_minmax(0,440px)] md:items-center">
    <div>
      <p class="font-mono text-xs font-bold tracking-[0.12em] text-primary">HOW IT WORKS</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">
        A tidy remote for Netflix's secret menu.
      </h2>
      <ol class="mt-8 space-y-6">
        {
          steps.map((step, index) => (
            <li class="flex gap-4">
              <span class="grid size-8 shrink-0 place-items-center rounded-md bg-tile font-mono text-sm font-bold text-accent">
                {index + 1}
              </span>
              <div>
                <h3 class="font-bold">{step.title}</h3>
                <p class="mt-1 text-muted-foreground">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="overflow-hidden rounded-xl border border-border shadow-2xl shadow-black/40">
      <Image
        src={browse}
        alt="The extension popup listing genre groups such as Featured Collections, Action & Adventure, and Anime, each with its code"
        widths={[440, 880]}
        sizes="(min-width: 768px) 440px, 100vw"
        class="h-auto w-full"
      />
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-20">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature) => (
          <li class="rounded-xl border border-border bg-card p-5">
            <p class="font-mono text-[11px] font-bold tracking-[0.1em] text-primary">
              {feature.number} / {feature.label.toUpperCase()}
            </p>
            <h3 class="mt-3 font-bold">{feature.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              {feature.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
