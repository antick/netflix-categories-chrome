---
import { Content } from "../../../../PRIVACY.md";
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";
---
<Base
  title="Privacy policy · Categories for Netflix"
  description="How the Categories for Netflix Chrome extension handles your data: storage-only permission, no analytics, no tracking, and nothing sent to a server."
  path="/privacy"
>
  <article
    class="mx-auto max-w-3xl px-5 py-16 text-muted-foreground leading-relaxed [&_a]:text-primary [&_a]:underline-offset-4 hover:[&_a]:underline [&_code]:rounded [&_code]:bg-tile [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-accent [&_h1]:text-4xl [&_h1]:font-extrabold [&_h1]:tracking-tight [&_h1]:text-foreground [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-foreground [&_p]:mt-4 [&_strong]:text-foreground"
  >
    <Content />
    <p class="mt-10 border-t border-border pt-6 text-sm">
      This page mirrors <a href={`${site.repository}/blob/main/PRIVACY.md`}>PRIVACY.md</a>{" "}
      in the source repository. It covers the extension; this website uses no
      cookies, analytics, or tracking either.
    </p>
  </article>
</Base>
